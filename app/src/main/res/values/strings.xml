<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">DSH PostAPI</string>

    <!-- ===== 登录页 ===== -->
    <string name="login_title">登录 DSH</string>
    <string name="login_subtitle">账号密码只在本机加密保存，用于下次打开时免去重新输入。点「退出登录」可随时清除。</string>
    <string name="label_host">服务地址</string>
    <string name="label_username">用户名</string>
    <string name="label_password">密码</string>
    <string name="action_login">登录</string>
    <string name="action_login_in_progress">正在登录…</string>

    <!--
      默认地址只是"预填"，**不是**某个真实服务：v0.3.0 起仓库里不留任何真实域名。
      首次使用的用户必须把它改成自己的 DSH 地址（README 已写明）。

      为什么是 127.0.0.1:3080 而不是空字符串：
        · 空输入框会让人以为不知道填什么，且点了登录才报错；
        · 127.0.0.1 是"本机"的通用写法，配合端口就是 DSH web 的默认监听端口，
          对"自己在电脑上跑了 dsh web、手机用 USB 端口转发"的调试场景直接可用；
        · 它不会被误认成某个公网服务（这是清除真实域名的目的）。

      translatable=false 的理由：这是一个技术性默认值，不该出现在翻译清单里；
      不同语言的用户改的是同一台服务器的地址。
    -->
    <string name="default_host" translatable="false">http://127.0.0.1:3080</string>

    <!-- ===== 登录校验与错误文案 =====
         每一条都对应一个可行动的方向：改输入 / 等待 / 找管理员 / 查域名配置。
         不要把它们合并成"登录失败"—— 那样用户无从判断下一步做什么。 -->
    <string name="error_host_invalid">服务地址格式不正确，应形如 https://dsh.example.com（可带端口，可省略 https://）</string>
    <string name="error_username_empty">请填写用户名</string>
    <string name="error_password_empty">请填写密码</string>
    <string name="error_network">无法连接服务器，请检查网络或地址是否正确</string>
    <string name="error_timeout">连接超时，请稍后重试</string>
    <string name="error_401">用户名或密码错误</string>
    <string name="error_429">尝试次数过多，请 10 分钟后再试</string>
    <string name="error_503">服务端暂时不可用（读不到启动令牌），请联系管理员检查 dsh web 日志</string>
    <string name="error_404">该地址上没有登录接口，请确认域名与反向代理配置</string>
    <string name="error_bad_response">服务器返回了无法解析的响应</string>
    <string name="error_server">服务器错误（HTTP %1$d）</string>

    <!-- ===== WebView 容器 ===== -->
    <string name="webview_loading">正在加载…</string>
    <string name="webview_error_title">页面加载失败</string>
    <string name="webview_error_message">可能是网络中断、服务器未启动，或登录状态已失效。</string>
    <string name="action_retry">重试</string>
    <string name="action_back_to_login">返回登录</string>
    <!--
      与上面那条不同：会话 cookie 被服务端吊销后，"返回登录"其实需要用户重新输入密码
      （本版不会自动重登，见 WebViewActivity.showError 的取舍说明），
      文案必须把这件事说在前面，否则用户会以为点了就自动好了。
    -->
    <string name="action_back_to_login_needs_password">返回登录（需重新输入密码）</string>
    <string name="webview_exit_hint">再按一次返回键退出</string>

    <!-- ===== 检查更新 =====
         文案原则：每条都指向一个可行动的下一步；技术原因以原始描述附在正文下方，
         不塞进人话里（否则用户读不懂，排查时我们又找不到）。 -->
    <string name="update_title">发现新版本 %1$s</string>
    <string name="update_message_no_notes">服务端未提供更新说明。建议更新以获取最新修复。</string>
    <string name="update_action_later">稍后</string>
    <string name="update_action_update">立即更新</string>
    <string name="update_action_cancel">取消</string>
    <string name="update_action_retry">重试</string>
    <string name="update_action_close">关闭</string>
    <string name="update_download_starting">正在准备下载…</string>
    <!-- 已下载 / 总大小 / 百分比：三个信息一起给，用户才能判断是在动还是卡住了 -->
    <string name="update_download_progress">%1$s / %2$s（%3$d%%）</string>
    <string name="update_download_progress_unknown">已下载 %1$s…</string>
    <string name="update_need_relogin">会话已失效，请返回登录页重新登录后再更新</string>
    <string name="update_permission_title">需要允许安装应用</string>
    <string name="update_permission_message">Android 要求先在本应用上打开「安装未知应用」开关，系统才能安装下载好的安装包。

下一步：点「去设置」→ 找到「允许来自此来源的应用」→ 打开 → 返回 App 重新点「立即更新」。</string>
    <string name="update_permission_action">去设置</string>
    <string name="update_install_failed">无法拉起安装器：%1$s</string>
    <string name="update_error_title">下载失败</string>
    <string name="update_error_no_space">存储空间不足：需要约 %1$s，当前可用 %2$s。请清理后再重试。</string>
    <string name="update_error_checksum">安装包校验失败（sha256 不一致），文件已删除。可能是下载被中断或服务端文件已更新，请重试。</string>
    <string name="update_error_timeout">下载超时，网络可能不稳定。请重试。</string>
    <string name="update_error_http">服务器拒绝下载（HTTP %1$d），可能登录已过期。可返回登录页重新登录后再试。</string>
    <string name="update_error_not_ready">服务端还没有放好安装包，请稍后再试。</string>
    <string name="update_error_generic">下载未完成，请重试。</string>

    <!-- ===== 诊断模式（v0.4.8）=====
         用途：排查「切换会话后侧栏自动收起失效」。开启后插件（v1.7.1）会在页面上
         采集判定过程并画一个诊断浮层；关掉即停止（浮层同时移除）。

         文案原则：抽屉里的开关本身要保持短（"诊断模式"），所以**状态**不进文字，
         而是靠开关位置 + 一条"开启后"的提示条来说明（见 diag_mode_on_hint）。
         这不是普通用户功能，措辞可以直接说清它是排查用的，不必装可爱。 -->
    <string name="diag_mode">诊断模式</string>
    <!-- 开启后的可见提示（抽屉里开关下方的一行小字）。
         为什么必须有：开关一旦忘关，页面会一直保留诊断浮层、插件也一直在采集 ——
         用户看到这句话才知道"这东西还在跑，可以关掉了"。 -->
    <string name="diag_mode_on_hint">诊断已开启：页面右上角会显示诊断浮层。排查完请关闭。</string>
    <!-- 网页侧接口没就绪时的反馈（插件未注入 / 版本低于 v1.7.1）。
         必须给用户一个可行动的下一步，不能静默 —— 否则用户会以为开关坏了。 -->
    <string name="diag_mode_unavailable">网页侧诊断接口尚未就绪（插件需 v1.7.1 及以上）。开关已记下，页面加载完成后会自动重试。</string>

    <!-- ===== 检查更新：入口与「已是最新」（v0.4.0）=====
         用户反馈「更新之后又提示需要更新，给个弹窗说已是最新就自己消失」。
         现在的规则（用户确认的方案）：
           · 自动检查（启动/登录后）→ 有新版本才弹，已最新**完全静默**；
           · 用户主动点「检查更新」→ 已最新则弹 Toast，3 秒自动消失。
         所以下面这条文案只会出现在"用户主动查"的场景，用词要短、不打断操作。 -->
    <string name="update_check_action">检查更新</string>
    <string name="update_up_to_date">已是最新版本（v%1$s）</string>
    <!-- 用户主动点了检查、但请求失败：必须给反馈（静默等于"点了没反应"）。
         正文带原始原因，便于用户判断是网络还是服务端。 -->
    <string name="update_check_failed">检查更新失败：%1$s</string>
    <!-- 服务端返回了响应但解析不出（契约变化/被反代改写）：比通用失败更精确一点。 -->
    <string name="update_check_failed_empty">检查更新失败：服务端返回了无法识别的版本信息</string>

    <!-- ===== 清除已保存的账号（v0.4.0，问题 ③）=====
         与「退出登录」严格区分：退出登录只结束会话，这里才会把地址/用户名/密码一起抹掉。
         文案必须让用户在点之前就知道"之后要重新填三样东西"。 -->
    <string name="clear_account_link">清除已保存的账号</string>
    <string name="clear_account_title">清除已保存的账号</string>
    <string name="clear_account_message">将从本机删除服务地址、用户名、密码与登录状态，且无法撤销。下次打开需要重新填写全部信息。

只是想换个账号或结束本次登录，用「退出登录」即可，不需要清除账号。</string>
    <string name="clear_account_action">清除</string>
    <string name="clear_account_done">已清除本机保存的账号</string>

    <!-- ===== 账号本地记忆 / 自动重登（v0.3.0）=====
         文案原则同上面几条：每一条都要说清"发生了什么"和"你现在能做什么"，
         不能只说"登录失败"——自动重登与用户手动点登录，用户的心理预期不同。 -->
    <string name="auto_login_in_progress">正在用上次的账号自动登录…</string>
    <!-- 401 / 403：唯一会清除密码的两种情形，必须明说"密码已清除"，否则用户会奇怪下次为什么又要输 -->
    <string name="auto_login_credentials_rejected">保存的账号密码已失效（可能改过密码或账号被停用）。已清除本机保存的密码，请重新输入。</string>
    <string name="auto_login_network">暂时无法连接服务器，还没有用保存的账号登录。网络恢复后可重试，保存的账号仍在。</string>
    <string name="auto_login_rate_limited">尝试次数过多，服务端暂时限制登录（约 10 分钟）。保存的账号仍然保留，稍后再试即可。</string>
    <string name="auto_login_server_error">服务器暂时无法完成登录，保存的账号仍然保留，稍后可重试。</string>
    <string name="auto_login_host_invalid">保存的服务地址无法解析，请重新填写服务地址。</string>
    <string name="auto_login_retry_unavailable">已没有可自动登录的账号，请手动输入密码。</string>

    <!-- ===== 退出登录（v0.3.0，v0.4.0 改语义）=====
         「退出登录」与「返回登录」是两件事，文案必须区分：
         前者结束会话，后者只是重新登一次同一个账号。

         v0.4.0（问题 ③）：退出登录**不再**清地址/用户名/密码 —— 用户反馈"退出后要重新输入"
         是设计错误。所以文案必须改成"结束这次登录"，否则用户会以为账号被清了。
         彻底清除的入口在登录页（clear_account_link），两者文案要能一眼区分。 -->
    <string name="logout_title">退出登录</string>
    <string name="logout_short">菜单</string>
    <!-- v0.4.1：原用于右侧抽屉的标题文案。
         v0.4.11：抽屉标题已从布局里删除（只有 4 项，标题没有信息量）。
         ⚠️ 这条字符串**必须保留** —— 它仍是悬浮按钮的 contentDescription
         （activity_webview.xml 的 logoutFab），读屏用户靠它知道这个按钮是什么。
         删掉会让无障碍朗读变成「按钮」，入口对读屏用户即等于消失。 -->
    <string name="app_menu_title">更多</string>
    <!-- ===== 切换桌面版 / 移动版（v0.4.11）=====
         文案由代码按当前状态动态设置：手机模式显示"切换桌面版"，桌面模式显示"切换移动版"
         （按钮上的字说的是**点下去会发生什么**，不是当前状态 —— 与开关类控件相反，
           因为这是动作按钮，不是状态指示器）。
         DSH 是纯 CSS 响应式、不看 UA，切换的实质是把 viewport 的宽度在
         device-width 与 980 之间来回切（见 WebViewActivity.applyDesktopViewport）。 -->
    <string name="switch_to_desktop">切换桌面版</string>
    <string name="switch_to_mobile">切换移动版</string>
    <string name="app_menu_version_format">DSH PostAPI v%1$s (%2$d)</string>
    <string name="logout_message">将结束本次登录并清除登录状态。本机保存的服务地址、用户名与密码会保留，下次打开可直接登录。确定退出？</string>
    <string name="logout_action_confirm">退出登录</string>
    <string name="logout_action_cancel">取消</string>
    <string name="logout_done">已退出登录，账号已保存在本机</string>

    <!-- ===== 文件选择器 / 网页权限请求（v0.3.1）=====
         用户反馈「无法上传文件」的根因是没有 WebChromeClient（见 WebViewActivity）。
         这几条都是**兜底路径**的文案，正常使用不会看到。 -->
    <!-- 极少数精简 ROM 没有系统文件选择器：必须明确告诉用户「无法选择文件」，
         否则点击上传没有任何反应，与修复前的现象一模一样，用户无法区分。 -->
    <!-- 拍照路径失败（建不出临时文件 / FileProvider 未覆盖该路径）。
         这两种都是配置/环境问题，用户能做的只有"改用文件选择器"，所以文案指向它。 -->
    <string name="webview_capture_failed">无法启动相机，已退回文件选择（可从相册选图片）</string>
    <!-- 系统文件选择器的标题（Intent.createChooser 的 title）。在部分 ROM 上会显示为
         "选择文件"对话框的标题；留空会让对话框只有一个无名标题栏，用户不知道在选什么。 -->
    <string name="webview_file_chooser_title">选择要上传的文件</string>
    <string name="webview_file_chooser_unavailable">本机没有可用的文件选择器，无法选择文件（请安装「文件」或「文档」类系统应用）</string>

    <!-- 网页申请摄像头/麦克风的确认框。
         关键点：本 App **没有**声明 CAMERA / RECORD_AUDIO，所以即使用户点「允许」，
         系统在真正打开设备时仍会失败。文案必须把这件事说清楚，
         不能承诺「允许后就能用」。 -->
    <string name="permission_request_title">网页请求使用麦克风或摄像头</string>
    <string name="permission_request_message">本应用没有申请麦克风/摄像头权限，即使允许，系统仍可能拒绝实际使用。一般直接拒绝即可，改用文字输入。</string>
    <string name="permission_request_allow">仍要允许</string>
    <string name="permission_request_deny">拒绝</string>

    <!-- ==================== v0.5.0：使用模式选择 ====================
         两种模式的关系不是「新旧」，而是「功能全 vs 轻快稳定」：
         完整模式是 WebView 承载 DSH 网页，功能与电脑端一致，但依赖系统 WebView 内核
         （旧内核如 Chrome 114 会卡）；兼容模式是纯原生界面，只要核心功能，
         但不依赖 WebView 内核。文案必须把「缺什么」说清楚，
         否则用户选了兼容模式后发现功能少了会觉得是 bug。 -->

    <string name="mode_title">选择使用方式</string>
    <string name="mode_subtitle">两种方式共用同一个账号和会话，随时可以在设置里切换</string>

    <string name="mode_full_title">完整模式</string>
    <string name="mode_full_tagline">功能完整 · 与电脑端一致</string>
    <string name="mode_full_features">· 全部功能：交付物下载、命令、@提及、审批、模型切换
· 界面与电脑端相同
· 依赖系统 WebView 内核，旧机型可能卡顿</string>

    <string name="mode_compat_title">兼容模式</string>
    <string name="mode_compat_tagline">轻快稳定 · 只要核心功能</string>
    <string name="mode_compat_features">· 会话列表、看消息、发消息
· 原生界面，打字和流式输出流畅
· 暂不支持交付物下载、命令、@提及（会自动切到完整模式）</string>

    <string name="mode_compat_not_recommended">当前设备 WebView 内核较旧，可能更适合兼容模式</string>
    <string name="mode_confirm">使用这个方式</string>
    <string name="mode_remember_hint">选择会记住，下次启动直接进入</string>

    <!-- 兼容模式占位界面（原生聊天界面开发中） -->
    <string name="compat_placeholder_title">兼容模式</string>
    <string name="compat_placeholder_body">原生聊天界面正在开发中。

当前可以先切回完整模式使用全部功能。</string>
    <string name="compat_switch_to_full">切换到完整模式</string>
    <string name="compat_logout">退出登录</string>

    <!-- 设置里的模式切换入口 -->
    <string name="mode_switch_title">切换使用方式</string>
    <string name="mode_switch_current">当前：%1$s</string>
</resources>
