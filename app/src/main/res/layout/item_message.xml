<?xml version="1.0" encoding="utf-8"?>
<!--
  一条消息 + 它下面挂的交付物卡片（v0.7.0）。

  用户消息靠右、助手消息靠左 —— 聊天类应用最通用的视觉约定。

  为什么交付物挂在消息下（而不是独立列表页）：
    「这个回复产出了这些文件」是因果关系的自然表达。独立列表页会让用户
    在一个平铺的文件堆里找不到「这是哪一轮产生的」。
    宿主事件里 deliverable 与 assistant 消息都有 turn 字段，正是为此设计的关联键。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/msgText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_card"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:textIsSelectable="true"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- 交付物容器：由代码动态填充，无交付物时 GONE -->
    <LinearLayout
        android:id="@+id/deliverablesBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
